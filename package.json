{
  "name": "jusivo-case-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@sendgrid/mail": "^8.1.5",
    "docx": "^9.5.1",
    "firebase": "^10.14.1",
    "html-docx-js": "^0.3.1",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.510.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router": "7.8.1",
    "serve": "^14.2.3",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "9.25.1",
    "@gannonh/firebase-mcp": "^1.4.9",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.14.1",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.4.1",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "firebase-tools": "^14.16.0",
    "globals": "15.15.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "5.8.3",
    "typescript-eslint": "8.31.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "start": "serve -s dist -l $PORT",
    "build": "vite build --mode production",
    "build:check": "tsc -b && vite build",
    "check": "tsc && vite build",
    "dev": "vite",
    "lint": "eslint .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "firebase:login:ci": "npx firebase login:ci",
    "firebase:init": "npx firebase init hosting --project $FIREBASE_PROJECT_ID --non-interactive --force",
    "deploy": "vite build && npx firebase deploy --only hosting --project $FIREBASE_PROJECT_ID",
    "mcp:firebase": "dotenv -e .env.firebase npx -y @gannonh/firebase-mcp",
    "firebase:seed": "node scripts/firebase/seed-firestore.mjs"
  }
}
