# Backend Provider Configuration
# Set this to choose your backend service: appwrite, firebase, supabase, custom
VITE_BACKEND_PROVIDER=appwrite

# Appwrite Configuration (default backend)
VITE_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6897443a0034c54b3fd8

# Legacy Appwrite configuration for setup scripts (Node SDK)
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6897443a0034c54b3fd8
# Paste your Appwrite API key below (format: standard_xxx). Do NOT commit a real key.
APPWRITE_API_KEY=

# For other backend providers, see .env.backend.example
