#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Linear Integration Pre-commit Hook
# This hook ensures that all commits reference a Linear issue

echo "🔍 Checking for Linear issue references..."

# Get the commit message
COMMIT_MSG=$(cat $1)

# Check if commit message contains Linear issue reference
if echo "$COMMIT_MSG" | grep -q "RAY-[0-9]\+"; then
  echo "✅ Linear issue reference found in commit message"
  exit 0
else
  echo "❌ No Linear issue reference found in commit message"
  echo ""
  echo "Please include a Linear issue reference in your commit message."
  echo "Example: RAY-123: Add user authentication feature"
  echo ""
  echo "If this is a minor change that doesn't require a Linear issue,"
  echo "you can bypass this check with: git commit --no-verify"
  echo ""
  exit 1
fi
